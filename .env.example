# MySQL on cPanel. When these are filled, the app stores data in MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DEFAULT_ADMIN_PASSWORD=

# Google Sheets service account setup
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Products
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional alternative to GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_PRIVATE_KEY
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
