{
  "manifest_version": 3,
  "name": "GIA NHAP Zalo Picker",
  "description": "Chon nhieu doan chat lon tren Zalo Web va copy thu cong sang gianhap.id.vn.",
  "version": "0.1.0",
  "action": {
    "default_title": "Mo GIA NHAP panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://chat.zalo.me/*",
    "https://*.zalo.me/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.zalo.me/*", "https://*.zalo.me/*"],
      "js": ["content/zalo.js"],
      "run_at": "document_idle"
    }
  ]
}
